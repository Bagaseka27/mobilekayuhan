<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#E9E4DB"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Judul + Tombol -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:text="Manajemen Menu"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0A3D2E"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnTambah"
            android:text="+ Tambah Menu"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A3D2E"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Card Table -->
    <androidx.cardview.widget.CardView
        android:layout_marginTop="20dp"
        app:cardCornerRadius="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <TableLayout
                android:id="@+id/tableMenu"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- Header: Disesuaikan dengan urutan dan ukuran baris data Kotlin -->
                <TableRow
                    android:background="#F3F3F3"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:gravity="center_vertical">

                    <!-- Judul Kolom Foto ditaruh paling kiri (Lebar 76dp pas dengan margin gambar di Kotlin) -->
                    <TextView
                        android:text="Foto Menu"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:padding="4dp"
                        android:layout_width="76dp"/>

                    <TextView
                        android:text="ID"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:layout_width="60dp"/>

                    <TextView
                        android:text="Nama Menu"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:layout_width="120dp"/>

                    <TextView
                        android:text="Kategori"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:layout_width="100dp"/>

                    <TextView
                        android:text="Harga Jual"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:layout_width="90dp"/>

                    <TextView
                        android:text="Aksi"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:padding="4dp"
                        android:layout_width="160dp"/>

                </TableRow>

            </TableLayout>
        </HorizontalScrollView>

    </androidx.cardview.widget.CardView>

</LinearLayout>